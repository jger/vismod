{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vismod.dev/schemas/vismod.v1.schema.json",
  "title": "VisMod Flow Definition",
  "description": "Canonical schema for *.vismod.yaml visual-modular decision flows.",
  "type": "object",
  "additionalProperties": false,
  "required": ["vismod", "id", "name", "entry", "steps"],
  "properties": {
    "vismod": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$",
      "description": "VisMod specification version (e.g. '0.1')."
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "description": "Unique identifier for the flow."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable name displayed in the viewer."
    },
    "description": {
      "type": "string",
      "description": "Optional summary of what this flow governs."
    },
    "visibility": {
      "type": "string",
      "enum": ["public", "admin", "internal"],
      "default": "admin",
      "description": "Who may view this flowchart inside the host application."
    },
    "entry": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$",
      "description": "Step ID where execution begins."
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "description": "Optional metadata such as owner, tags, or domain."
    },
    "dependencies": {
      "type": "array",
      "description": "Reserved for Phase 3 system-level dependency mapping.",
      "items": {
        "type": "object",
        "required": ["target", "kind"],
        "properties": {
          "target": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "enum": ["service", "module", "database", "api", "queue"] },
          "description": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "stepId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
    },
    "step": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": { "$ref": "#/$defs/stepId" },
        "type": {
          "type": "string",
          "enum": ["action", "decision", "subflow", "end"]
        },
        "label": { "type": "string" },
        "description": { "type": "string" },
        "handler": {
          "type": "string",
          "minLength": 1
        },
        "flow": {
          "type": "string",
          "minLength": 1
        },
        "params": {
          "type": "object",
          "additionalProperties": true
        },
        "next": { "$ref": "#/$defs/stepId" },
        "branches": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/stepId" }
        },
        "default": { "$ref": "#/$defs/stepId" }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "action" } } },
          "then": { "required": ["handler", "next"] }
        },
        {
          "if": { "properties": { "type": { "const": "decision" } } },
          "then": { "required": ["handler", "branches"] }
        },
        {
          "if": { "properties": { "type": { "const": "subflow" } } },
          "then": { "required": ["flow", "next"] }
        },
        {
          "if": { "properties": { "type": { "const": "end" } } },
          "then": {
            "not": {
              "anyOf": [
                { "required": ["next"] },
                { "required": ["branches"] }
              ]
            }
          }
        }
      ]
    }
  }
}
