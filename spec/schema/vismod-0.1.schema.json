{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/jger/vismod/main/spec/schema/vismod-0.1.schema.json",
  "title": "VisMod Flow Definition",
  "description": "Canonical schema for *.vismod.yaml visual-modular decision flows (spec v0.1).",
  "type": "object",
  "additionalProperties": false,
  "required": ["vismod", "id", "name", "entry", "steps"],
  "properties": {
    "vismod": {
      "const": "0.1",
      "description": "VisMod specification version ('0.1')."
    },
    "id": {
      "$ref": "#/$defs/identifier",
      "description": "Unique lowercase identifier for the flow."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable name displayed in the viewer."
    },
    "description": {
      "type": "string",
      "description": "Optional summary of what this flow governs."
    },
    "visibility": {
      "type": "string",
      "enum": ["public", "admin", "internal"],
      "default": "admin",
      "description": "Who may view this flowchart inside the host application."
    },
    "entry": {
      "$ref": "#/$defs/identifier",
      "description": "Step ID where execution begins."
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "description": "Optional metadata such as owner, tags, or domain."
    },
    "dependencies": {
      "type": "array",
      "description": "Reserved for Phase 3 system-level dependency mapping.",
      "items": {
        "type": "object",
        "required": ["target", "kind"],
        "properties": {
          "target": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "enum": ["service", "module", "database", "api", "queue"] },
          "description": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "branchKey": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "step": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "type": {
          "type": "string",
          "enum": ["action", "decision", "subflow", "end"]
        },
        "label": { "type": "string" },
        "description": { "type": "string" },
        "handler": {
          "type": "string",
          "minLength": 1
        },
        "flow": {
          "type": "string",
          "minLength": 1
        },
        "params": {
          "type": "object",
          "additionalProperties": true
        },
        "next": { "$ref": "#/$defs/identifier" },
        "branches": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "#/$defs/branchKey" },
          "additionalProperties": { "$ref": "#/$defs/identifier" }
        },
        "default": { "$ref": "#/$defs/identifier" }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "action" } } },
          "then": {
            "required": ["handler", "next"],
            "properties": {
              "branches": false,
              "default": false,
              "flow": false
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "decision" } } },
          "then": {
            "required": ["handler", "branches"],
            "properties": {
              "next": false,
              "flow": false
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "subflow" } } },
          "then": {
            "required": ["flow", "next"],
            "properties": {
              "handler": false,
              "branches": false,
              "default": false
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "end" } } },
          "then": {
            "properties": {
              "next": false,
              "branches": false,
              "default": false,
              "flow": false
            }
          }
        }
      ]
    }
  }
}
